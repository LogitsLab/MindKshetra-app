# Copy to .env and start — no secrets required. These variables are the
# ones the app reads (src/api/client.ts, src/auth/supabase.ts, src/audio/*).
# All EXPO_PUBLIC_* values are embedded in the client bundle by design: the
# Supabase key below is a publishable key, not a secret, and this exact pair
# is already committed in eas.json ("dev-backend" profile).
#
# The API URL and Supabase project must belong to the same stack — the app
# sends Supabase session tokens to the API as Bearer auth.

# Dev stack (default for contributors):
EXPO_PUBLIC_API_URL=https://mind-dev.logitslab.com
EXPO_PUBLIC_SUPABASE_URL=https://awqvyohcdxamkacwlsnq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_sEuLUIynHFGiFogHqN3Xtg_FypVeoGV
EXPO_PUBLIC_AUDIO_BASE_URL=https://bpxszivjvexmqznnshlx.supabase.co/storage/v1/object/public/audio

# Model A sangha channels (Community screen). Leave unset to show the honest
# "check back soon" copy — never invent placeholder URLs.
# EXPO_PUBLIC_WHATSAPP_CHANNEL_URL=https://chat.whatsapp.com/...
# EXPO_PUBLIC_TELEGRAM_URL=https://t.me/...

# Community kill switches (mirror web NEXT_PUBLIC_COMMUNITY_*). Unset = PAUSED.
# Do not enable in casual local builds — sharing/reporting stay gated until
# moderation is ready. Values: 1 | true | on | yes to open.
# EXPO_PUBLIC_COMMUNITY_REFLECTIONS_ENABLED=0
# EXPO_PUBLIC_COMMUNITY_REPORTS_ENABLED=0

# Working on API + app together? Point at your local Next.js server from the
# web repo (https://github.com/LogitsLab/MindKshetra) and use that server's
# Supabase project for the pair above:
#   EXPO_PUBLIC_API_URL=http://localhost:3000     (simulator)
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3000   (device on your LAN)
