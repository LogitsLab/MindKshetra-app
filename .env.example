# Copy to .env and start — no secrets required. These three variables are the
# only ones the app reads (src/api/client.ts, src/auth/supabase.ts). All
# EXPO_PUBLIC_* values are embedded in the client bundle by design: the
# Supabase key below is a publishable key, not a secret, and this exact pair
# is already committed in eas.json ("dev-backend" profile).
#
# The API URL and Supabase project must belong to the same stack — the app
# sends Supabase session tokens to the API as Bearer auth.

# Dev stack (default for contributors):
EXPO_PUBLIC_API_URL=https://mind-dev.logitslab.com
EXPO_PUBLIC_SUPABASE_URL=https://xtadssxgwskyobxmhnxa.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KBNmCiZpJC6Sqd0-9XF4Lg_qgrJoOz-

# Working on API + app together? Point at your local Next.js server from the
# web repo (https://github.com/LogitsLab/MindKshetra) and use that server's
# Supabase project for the pair above:
#   EXPO_PUBLIC_API_URL=http://localhost:3000     (simulator)
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3000   (device on your LAN)
