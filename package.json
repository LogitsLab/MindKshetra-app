{
  "name": "mindkshetra-app",
  "version": "2.2.1",
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:routes": "node scripts/validate-routes.mjs",
    "test:e2e": "maestro test e2e/maestro/flows",
    "expo:check": "expo install --check && expo-doctor",
    "quality": "npm run typecheck && npm test -- --ci --runInBand && npm run test:routes && npm run expo:check",
    "brand:assets": "node scripts/render-brand-assets.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:testflight": "eas build --platform ios --profile production-ios --auto-submit-with-profile=production-play --non-interactive",
    "release:stores": "eas build --platform ios --profile production-ios --auto-submit-with-profile=production-play --non-interactive --no-wait && eas build --platform android --profile production --auto-submit-with-profile=production-play --non-interactive --no-wait"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/noto-serif-devanagari": "^0.4.1",
    "@expo-google-fonts/sora": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~57.0.0",
    "expo-doctor": "^1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "private": true
}
