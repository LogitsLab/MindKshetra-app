{
  "expo": {
    "name": "MindKshetra",
    "slug": "mindkshetra",
    "version": "1.1.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mindkshetra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mindkshetra.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "MindKshetra sends gentle reminders for your daily verse and practice streak."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.mindkshetra.mobile",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090f",
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A227",
          "defaultChannel": "daily-verse",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ab537e8-d074-4e31-bc69-4015ed17f6fe"
      }
    },
    "owner": "logitsllab"
  }
}
