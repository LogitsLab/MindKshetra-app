{
  "expo": {
    "name": "MindKshetra",
    "slug": "mindkshetra",
    "version": "2.1.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mindkshetra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090f"
    },
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.mindkshetra.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "MindKshetra sends gentle reminders for your daily verse and practice streak.",
        "NSMicrophoneUsageDescription": "MindKshetra uses the microphone so you can speak to Madhav instead of typing.",
        "NSSpeechRecognitionUsageDescription": "MindKshetra turns your speech into text so Madhav can answer.",
        "NSPhotoLibraryUsageDescription": "MindKshetra needs photo library access only if you choose to share an image. A linked library may request this even when you are not attaching a photo."
      },
      "buildNumber": "24"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.mindkshetra.mobile",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ],
      "versionCode": 29
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A227",
          "defaultChannel": "daily-verse",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MindKshetra uses the microphone so you can speak to Madhav instead of typing.",
          "speechRecognitionPermission": "MindKshetra turns your speech into text so Madhav can answer.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93fe4bed-65b9-4c63-bac0-8a3c8e6b3a46"
      }
    },
    "owner": "imsaksham.c"
  }
}
