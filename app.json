{
  "expo": {
    "name": "MindKshetra",
    "slug": "mindkshetra",
    "version": "2.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mindkshetra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mindkshetra.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "MindKshetra sends gentle reminders for your daily verse and practice streak."
      },
      "buildNumber": "23"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.mindkshetra.mobile",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 28
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090f",
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9A227",
          "defaultChannel": "daily-verse",
          "sounds": [],
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-asset",
      "expo-audio",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "93fe4bed-65b9-4c63-bac0-8a3c8e6b3a46"
      }
    },
    "owner": "imsaksham.c"
  }
}
